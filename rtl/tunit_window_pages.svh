localparam [4:0] WIN_NBAJAM = 5'd0;     // 1 page
localparam [4:0] WIN_NBAJAMTE = 5'd1;   // 4 pages
localparam [4:0] WIN_MK = 5'd5;         // 2 pages
localparam [4:0] WIN_MK2 = 5'd7;        // 12 pages

// MK: the page of each fighter (Fighter option order; several to a page)
function automatic [4:0] win_mk_page(input [2:0] fighter);
	case (fighter)
		3'd0: win_mk_page = 5'd5;
		3'd1: win_mk_page = 5'd5;
		3'd2: win_mk_page = 5'd5;
		3'd3: win_mk_page = 5'd5;
		3'd4: win_mk_page = 5'd6;
		3'd5: win_mk_page = 5'd6;
		3'd6: win_mk_page = 5'd6;
		default: win_mk_page = 5'd5;
	endcase
endfunction
